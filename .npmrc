# Supply-chain hardening (added during the 2026-11 security audit).
# Do not run dependency lifecycle scripts (preinstall/install/postinstall) on install.
# Explicit commands such as `npm run build` and `npm test` still run their script.
ignore-scripts=true
# Only install versions that have been published for at least 7 days (npm >= 11).
min-release-age=7
# Never fetch dependencies from git URLs or remote tarball URLs.
allow-git=none
allow-remote=none
